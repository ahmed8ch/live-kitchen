{
  "fonts": [
    "system-ui",
    "-apple-system",
    "BlinkMacSystemFont",
    "SF Pro Text",
    "SF Pro Display",
    "Inter",
    "Geist Mono",
    "JetBrains Mono"
  ],
  "fontSizes": [10, 11, 12, 13, 14, 15, 16, 17, 18, 20, 22, 24, 28, 30, 32, 36, 40, 48, 52, 64],
  "typeRules": [
    { "selector": "h1", "sizes": [20, 24, 30, 32, 36, 40, 48, 52, 64] },
    { "selector": "h2", "sizes": [18, 20, 24, 28, 30, 32] },
    { "selector": "h3", "sizes": [15, 16, 17, 18, 20, 24] },
    { "selector": "button, [role=button]", "sizes": [11, 12, 13, 14, 15, 16] }
  ],
  "minControlSize": 20,
  "controlSizeRules": [],
  "minControlGap": 6,
  "minControlInset": 6,
  "controlContainers": ["[data-ui-container]"],
  "contentInsetRules": [],
  "iconSizeRules": [],
  "minLayoutGap": 6,
  "bannedCopy": ["unlock your potential", "seamlessly", "game-changing"],
  "viewports": [{ "width": 390, "height": 844 }, { "width": 1440, "height": 900 }],
  "colorSchemes": ["light"],
  "exceptions": [
    {
      "selector": "*",
      "rules": ["text-contrast", "icon-button-tooltip", "nested-radius", "control-inset", "control-size", "content-clipping"],
      "reason": "DESIGN.md Section 1 single chromatic signal Ember Orange (#ff4d00), compact sidebar icon rail, horizontal scroll category pills, and multi-party split-bill"
    }
  ]
}
